# Секреты. Не коммитить, не публиковать. Лежит рядом с docker-compose.yml.

# База данных (PostgreSQL уже на сервере)
DATABASE_URL=postgresql+psycopg2://postgres:cd5d56a8@host.docker.internal:5432/camera

# Токен камеры: ЭТОТ ЖЕ токен пропиши в клиенте, который шлёт видео
UPLOAD_TOKEN=t1n8bzy0uL_WpRcxZWOhxP9yVKM3bsvd1eYH6fr46sY

# Секрет подписи сессий (смена = разлогинит всех)
JWT_SECRET=Cgp4XpN9saCZuH-xWoPPNLd-4KP304MPCZvczH8knCHsE70EmLV5b5DN9I2PT4WI

# Учётка панели (создаётся при первом старте, только если её ещё нет в БД)
ADMIN_USER=vivi-admin
ADMIN_PASSWORD=vivimonitoring

# Куки: HTTPS включён → Secure-куки
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Разрешённые источники (адрес, по которому открываешь панель)
ALLOWED_ORIGINS=https://vivi-control.tw1.ru

# Хранилище внутри контейнера (том смонтирован сюда из ./storage)
STORAGE_DIR=/app/storage

# ffmpeg внутри образа — в PATH
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Онлайн, если камера присылала данные за последние N секунд (1800 = 30 мин)
DEVICE_ONLINE_SECONDS=1800

# Сколько дней хранить архив (старше — авто-удаление; 0 — не удалять)
RETENTION_DAYS=1

# Лимит размера одного загружаемого файла, байт (512 МБ)
MAX_FILE_SIZE=536870912

DEEPGRAM_API_KEY=3231f670841a2dd76a8594c5249bf3037f23c4ef

DEEPGRAM_MODEL=nova-3
TRANSCRIBE_MIN_DB=-55

MISTRAL_API_KEY=xtQtIjRbUAGRRd3ebsq6RDxtGhbmaHF6


