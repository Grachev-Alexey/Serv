# СЕКРЕТЫ — НЕ коммитить (файл в .gitignore). Для прода задать свои значения.

# PostgreSQL (сервер). Пароль сменить после того, как он засветился в переписке.
DATABASE_URL=postgresql+psycopg2://postgres:cd5d56a8@213.226.124.2:5432/camera

# Токен, которым камеры авторизуют загрузку (POST /api/upload)
UPLOAD_TOKEN=test_token_123

# Секрет для подписи JWT-сессий панели (в проде — длинная случайная строка)
JWT_SECRET=dev-only-change-me-in-production

# Учётка администратора, создаётся при первом старте
ADMIN_USER=vivi-admin
ADMIN_PASSWORD=vivimonitoring

# Cookie: в проде за HTTPS выставить true
COOKIE_SECURE=false

# Разрешённые источники для CORS (дев-фронт Vite)
ALLOWED_ORIGINS=http://localhost:5173

# Пути к ffmpeg/ffprobe (на Ubuntu достаточно ffmpeg/ffprobe в PATH)
