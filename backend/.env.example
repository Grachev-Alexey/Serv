# Шаблон окружения. Скопировать в .env и заполнить реальными значениями.

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# Токен камер для POST /api/upload
UPLOAD_TOKEN=change-me

# Секрет подписи JWT-сессий (длинная случайная строка)
JWT_SECRET=change-me

# Администратор (создаётся при первом старте)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# true за HTTPS в проде
COOKIE_SECURE=false

# Разрешённые источники CORS (в проде — домен панели)
ALLOWED_ORIGINS=http://localhost:5173

# ffmpeg/ffprobe (на Ubuntu обычно просто ffmpeg/ffprobe из пакета)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
